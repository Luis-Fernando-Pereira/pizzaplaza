@startuml C4_Component_OrderService
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Pizza Plaza - Order Service (Component Diagram)

Container(api_gateway, "API Gateway", "Gateway", "Ponto de entrada das APIs")

Container_Boundary(order, "Order Service - Quarkus") {

    Component(order_controller, "OrderController", "REST Controller (Quarkus)","Expõe endpoints REST para criação, consulta e atualização de pedidos")

    Component(order_service, "OrderService", "Business Service", "Implementa regras de negócio de pedidos")

    Component(order_validator, "OrderValidator", "Domain Validator","Valida regras de negócio como status, cancelamento e itens mínimos")

    Component(order_repository, "OrderRepository", "JPA Repository","Acesso a dados da entidade Pedido")

    Component(pizza_repository, "PizzaRepository", "JPA Repository","Acesso a dados da entidade Pizza")

    Component(pizza_service, "PizzaService", "Business Service","Implementa regras de negócio de pizzas")
}

System_Boundary(product_service, "Product Microservice") {
    Container(flavor_api, "Flavor API", "Quarkus", "Responsável pelos sabores")
}

ContainerDb(database, "PostgreSQL", "PostgreSQL 18", "Banco de dados do sistema")

Rel(api_gateway, order_controller, "Chama endpoints REST", "HTTPS/JSON")

Rel(order_controller, order_service, "Invoca operações")

Rel(order_service, order_validator, "Valida regras")

Rel(order_service, order_repository, "Gerencia pedidos")

Rel(pizza_service, pizza_repository, "Mapeia entidade")
Rel(order_service, pizza_service, "Mapeia entidade")

Rel(pizza_service, flavor_api, "Consulta sabores", "HTTP/REST")

Rel(order_repository, database, "Lê/Escreve", "JPA/Hibernate")
Rel(pizza_repository, database, "Lê/Escreve", "JPA/Hibernate")

@enduml
