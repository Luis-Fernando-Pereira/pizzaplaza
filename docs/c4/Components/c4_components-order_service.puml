@startuml C4_Component_OrderService
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Pizza Plaza - Order Service (Component Diagram)

Person(admin, "Admin / Vendedor", "Avança o status dos pedidos")
Person(cliente, "Cliente", "Acompanha status em tempo real via SSE")
Container(api_gateway, "API Gateway", "Gateway", "Ponto de entrada das APIs")

Container_Boundary(order, "Order Service - Quarkus") {

    Component(order_controller, "OrderController", "REST Controller (Quarkus)",
        "Expõe endpoints: POST /orders, GET /orders, GET /orders/my,\nPATCH /orders/{oid}/advance-status, GET /orders/events (SSE)")

    Component(order_service_bean, "OrderService", "Business Service",
        "Regras de negócio: criação de pedido e avanço de status\n(RECEIVED → PREPARING → LEFT_FOR_DELIVERY → DELIVERED)")

    Component(order_status_notifier, "OrderStatusNotifier", "CDI Bean / SSE Publisher",
        "Mantém um BroadcastProcessor<OrderStatusEventDto>.\nEmite eventos de mudança de status para todos os clientes conectados via SSE")

    Component(order_repository, "OrderRepository", "JPA Repository",
        "Acesso a dados da entidade Pedido")

    Component(jwt_parser, "JWTParser (SmallRye)", "Security",
        "Valida o token JWT recebido como query param (?token=) no endpoint SSE")
}

ContainerDb(database, "PostgreSQL", "PostgreSQL 18", "Banco de dados do sistema")

Rel(api_gateway, order_controller, "Chama endpoints REST e SSE", "HTTPS/JSON + SSE")
Rel(admin, api_gateway, "PATCH /advance-status", "REST")
Rel(cliente, api_gateway, "GET /events?token=", "SSE")

Rel(order_controller, order_service_bean, "Delega operações de negócio")
Rel(order_controller, order_status_notifier, "Subscreve ao stream SSE")
Rel(order_controller, jwt_parser, "Valida JWT do query param para endpoint SSE")

Rel(order_service_bean, order_repository, "Persiste e consulta pedidos")
Rel(order_service_bean, order_status_notifier, "Emite evento após avançar status")

Rel(order_repository, database, "Lê/Escreve", "JPA/Hibernate")

@enduml
